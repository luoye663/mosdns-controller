# 本地密钥和运行数据绝不能进入版本库。
deploy/secrets/*
!deploy/secrets/.gitkeep
*.db
*.db-shm
*.db-wal
*.dump

# 构建产物与本地依赖。
mosdns/mosdns
controller/controller
web/node_modules/
web/dist/
web/*.tsbuildinfo
.local/
.DS_Store

controller/internal/web/static/*
!controller/internal/web/static/.gitkeep

# 原生二进制部署包由 make binary-package 生成。
deploy/binary/package/*
deploy/binary/*.tar.gz

# mosdns runtime configurations are generated from deploy/mosdns/config.yaml.tmpl.
deploy/mosdns/config.yaml
deploy/mosdns/config.integration.yaml
deploy/local/mosdns.yaml
deploy/controller/config.yaml
deploy/local/controller.yaml
