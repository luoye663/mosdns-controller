# 本模板由 deploy/render-mosdns-config.sh 按 compose、local、integration、binary profile 渲染。
# ${...} 为渲染变量；$plugin_tag 为 mosdns sequence 的插件引用，渲染时保持原样。

log:
  level: info

# mosdns 插件 HTTP API 监听地址。生产 Compose 仅在内部网络暴露，不映射到宿主机。
api:
  http: "${MOSDNS_API_LISTEN}"

plugins:
  # 管理页面发布的手工规则和整源订阅规则。
  - tag: dynamic_rules
    type: dynamic_rule_engine
    args:
      snapshot_file: "${MOSDNS_STATE_DIR}/dynamic-rules.json"
      backup_file: "${MOSDNS_STATE_DIR}/dynamic-rules.json.bak"
      auth_token_file: "${MOSDNS_TOKEN_FILE}"
      # 规则、正则和 API 请求体安全上限。
      max_rules: 200000
      max_regexp_rules: 500
      max_request_body_bytes: 67108864
      fail_open_on_snapshot_error: true
      marks:
        access_block: 1001
        access_allow: 1002
        no_log: 1201
        local_answer: 1301

  # 全局 A/AAAA 策略由管理页面热更新；默认保留双栈响应。
  - tag: address_family
    type: dynamic_address_family
    args:
      snapshot_file: "${MOSDNS_STATE_DIR}/address-family.json"
      backup_file: "${MOSDNS_STATE_DIR}/address-family.json.bak"
      auth_token_file: "${MOSDNS_TOKEN_FILE}"
      initial: { version: 1, mode: "dual_stack" }

  # DNS 后置审计。事件异步发送至 controller，队列满时丢弃而不阻塞 DNS。
  - tag: query_audit
    type: query_audit
    args:
      # controller ingest 地址、队列容量、批量大小、发送超时和重试次数。
      endpoint: "${QUERY_AUDIT_ENDPOINT}"
      auth_token_file: "${MOSDNS_TOKEN_FILE}"
      queue_size: ${QUERY_AUDIT_QUEUE_SIZE}
      batch_size: ${QUERY_AUDIT_BATCH_SIZE}
      flush_interval: "250ms"
      request_timeout: "${QUERY_AUDIT_TIMEOUT}"
      max_retries: ${QUERY_AUDIT_RETRIES}
      # 是否在审计事件中发送应答；默认关闭以减少隐私数据。
      include_answers: ${QUERY_AUDIT_INCLUDE_ANSWERS}
      include_error_text: true
      max_error_text_bytes: 256
      marks:
        access_block: 1001
        no_log: 1201
        cache_hit: 2101

  # Registry 原子管理任意上游组及其 ECS、缓存和调度运行时。
  - tag: dynamic_upstreams
    type: dynamic_upstream_registry
    args:
      snapshot_file: "${MOSDNS_STATE_DIR}/upstream-registry.json"
      backup_file: "${MOSDNS_STATE_DIR}/upstream-registry.json.bak"
      auth_token_file: "${MOSDNS_TOKEN_FILE}"
      initial_snapshot:
        schema_version: 2
        version: 1
        default_group_id: default_dns
        cache:
          enabled: true
          lazy_ttl: 0
          negative: { enabled: true, ttl: 30 }
        protection:
          global_max_in_flight: 1024
          default_group_max_in_flight: 256
          default_group_query_timeout_ms: 5000
          overload_action: servfail
        groups:
          - id: default_dns
            name: 默认上游
            enabled: true
            mode: race
            concurrent: ${DEFAULT_UPSTREAM_CONCURRENT}
            socks5: "${DEFAULT_UPSTREAM_SOCKS5}"
            ecs: { mode: off, mask4: 24, mask6: 48 }
            cache: { enabled: true, size: ${CACHE_SIZE} }
            upstreams:
              - { tag: ${DEFAULT_UPSTREAM_TAG}, addr: "${DEFAULT_UPSTREAM_ADDR}", priority: 100, weight: 1, timeout_ms: 1000 }

  - tag: forward_routes
    type: sequence
    args:
      - exec: $dynamic_upstreams
      - exec: accept

  # DNS 主入口：动态 block 必须先于任何 cache。
  - tag: main
    type: sequence
    args:
      # 后置审计必须在最前，才能观察后续转发、accept 与 reject 的结果。
      - exec: $query_audit
      - exec: $dynamic_rules
      # block 必须先于 cache，新增黑名单会立即生效。
      - matches:
          - mark 1001
        exec: reject 3
      # 自定义 A/AAAA 在黑名单之后直接完成，不进入地址族策略、缓存或上游。
      - matches:
          - mark 1301
        exec: accept
      # 地址族策略必须在缓存和上游之前执行，且不绕过访问封锁。
      - exec: $address_family
      - exec: goto forward_routes

  # DNS UDP/TCP 监听地址；生产通常为 :53，集成测试使用 :5353。
  - tag: udp_server
    type: udp_server
    args:
      entry: main
      listen: "${DNS_LISTEN}"

  - tag: tcp_server
    type: tcp_server
    args:
      entry: main
      listen: "${DNS_LISTEN}"
